{
  "collectionName": "components_navigation_nav_items",
  "info": {
    "displayName": "Navigation Item",
    "description": "Single navigation menu item"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true,
      "maxLength": 50,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "href": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "target": {
      "type": "enumeration",
      "enum": ["_self", "_blank"],
      "default": "_self"
    },
    "icon": {
      "type": "string",
      "maxLength": 50
    },
    "children": {
      "type": "component",
      "repeatable": true,
      "component": "navigation.nav-item"
    }
  }
}
