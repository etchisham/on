# Copy to .env.local for local development or .env.production for production.
# Never commit real secrets. Use a secrets manager in production.

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19

# Server-only. Required when the Sanity dataset is private.
SANITY_API_READ_TOKEN=

# Server-only webhook secret. Required for /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Production reverse proxy. Required by compose.prod.yaml.
APP_DOMAIN=example.com
STUDIO_DOMAIN=studio.example.com
TLS_CONTACT_EMAIL=ops@example.com

# Sanity Studio build-time configuration.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_STUDIO_APP_ID=
