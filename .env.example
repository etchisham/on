# Copy to .env.local for local development or .env.production for production.
# Never commit real secrets. Use a secrets manager in production.

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi CMS (Public URL for browser and SSR)
STRAPI_PUBLIC_URL=http://localhost:1337

# Strapi CMS (Internal URL for Docker server-to-server communication)
STRAPI_INTERNAL_URL=http://cms:1337

# Strapi API Token (server-only, read-only for frontend)
STRAPI_API_TOKEN=

# Webhook secret for Next.js revalidation endpoint
STRAPI_WEBHOOK_SECRET=

# PostgreSQL Database
POSTGRES_DB=strapi
POSTGRES_USER=strapi
POSTGRES_PASSWORD=

# Strapi Secrets (generate these for production)
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Production reverse proxy
APP_DOMAIN=example.com
CMS_DOMAIN=cms.example.com
TLS_CONTACT_EMAIL=ops@example.com
