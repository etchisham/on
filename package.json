{
  "name": "enterprise-content-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade Next.js frontend with self-hosted Strapi CMS.",
  "workspaces": [
    "apps/web",
    "apps/cms"
  ],
  "engines": {
    "node": ">=20.9.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:cms": "npm --workspace apps/cms run develop",
    "build": "npm run build:web",
    "build:web": "npm --workspace apps/web run build",
    "build:cms": "npm --workspace apps/cms run build",
    "start:web": "npm --workspace apps/web run start",
    "start:cms": "npm --workspace apps/cms run start",
    "lint": "npm run lint:web",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck": "npm run typecheck:web && npm run typecheck:cms",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "typecheck:cms": "npm --workspace apps/cms run typecheck",
    "audit": "npm audit --audit-level=high"
  },
  "devDependencies": {
    "@babel/runtime": "7.29.7",
    "@eslint/js": "9.39.1",
    "@next/eslint-plugin-next": "16.2.12",
    "@mux/mux-player": "3.13.2",
    "@sentry/browser": "10.69.0",
    "adm-zip": "0.6.0",
    "ajv": "6.15.0",
    "caniuse-lite": "1.0.30001806",
    "css-tree": "3.2.1",
    "date-fns": "4.4.0",
    "focus-lock": "1.3.6",
    "js-yaml": "4.1.1",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "refractor": "5.0.0",
    "rxjs": "7.8.2",
    "smol-toml": "1.7.1",
    "typescript-eslint": "8.65.0",
    "undici": "7.28.0"
  }
}
